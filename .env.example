# Optional: Custom SHA-256 hash for bossrod.com admin dashboard
# To generate a new hash:
# In PowerShell:
#   $pass = "YourSecretPassword"
#   $bytes = [System.Text.Encoding]::UTF8.GetBytes($pass.Trim().ToLower())
#   $hash = [System.Security.Cryptography.SHA256]::Create().ComputeHash($bytes)
#   [System.BitConverter]::ToString($hash).Replace("-","").ToLower()
#
# Defaults to SHA-256 of "bossrod" if omitted:
# VITE_ADMIN_PASS_HASH=b723528b97d2e0573e04e9c704f08f8bb1a4a4b27df77df8fa5b4b1a47dfd635
